    validation_notes    TEXT,
    created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
COMMENT ON TABLE explanation_logs IS 'Log de explicabilidade de cada recomendação do motor de engenharia conforme Mandato §2.3';
