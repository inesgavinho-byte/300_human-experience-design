generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum building_type {
  OFFICE
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  HOSPITAL
  SCHOOL
  HOTEL
  RETAIL
  WAREHOUSE
  DATA_CENTER
  OTHER
}

enum solution_level {
  NONE
  BASIC
  STANDARD
  ADVANCED
  PREMIUM
}

enum detection_state {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  APPROVED
}

enum requirement_category {
  FUNCTIONAL
  TECHNICAL
  PERFORMANCE
  SECURITY
  COMPLIANCE
  USER_EXPERIENCE
  INTEGRATION
  SUSTAINABILITY
  MAINTENANCE
  OTHER
}

enum system_category {
  HVAC
  LIGHTING
  SECURITY
  FIRE_SAFETY
  ELEVATOR
  PLUMBING
  ELECTRICAL
  IT_NETWORK
  BMS
  ENERGY_MANAGEMENT
  AUDIO_VISUAL
  PARKING
  CLEANING
  OTHER
}

enum subsystem_type {
  SENSOR
  CONTROLLER
  ACTUATOR
  GATEWAY
  SERVER
  DISPLAY
  METER
  SWITCH
  VALVE
  DAMPER
  PUMP
  FAN
  OTHER
}

enum equipment_status {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  PENDING
}

enum prescription_status {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
  ARCHIVED
}

enum prescription_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum integration_type {
  API
  WEBHOOK
  DATABASE
  FILE
  MESSAGE_QUEUE
  PROTOCOL
  CUSTOM
}

enum integration_status {
  ACTIVE
  INACTIVE
  ERROR
  PENDING
  DEPRECATED
}

enum user_role {
  admin
  engineer
  technician
  client
  viewer
}

enum proposal_status {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ============================================
// CORE ENTITY: PROFILES (Supabase Auth)
// ============================================

model profiles {
  id         String    @id @db.Uuid
  email      String?   @unique
  full_name  String?
  role       user_role @default(viewer)
  avatar_url String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  projects        projects[]
  prescriptions   prescriptions[]
  requirements    requirements[]
  experiences     experiences[]
  ai_learned_patterns ai_learned_patterns[]
  domain_events   domain_events[]
  proposals       proposals[]
  explanation_logs explanation_logs[]

  @@map("profiles")
}

// ============================================
// PARTIES
// ============================================

model clients {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  phone       String?
  address     String?
  vat_number  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  projects    projects[]

  @@map("clients")
}

model suppliers {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  phone       String?
  address     String?
  website     String?
  specialties Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  equipment   equipment[]

  @@map("suppliers")
}

// ============================================
// PROJECT HIERARCHY
// ============================================

model projects {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  client_id       String?        @db.Uuid
  responsible_id  String?        @db.Uuid
  start_date      DateTime?      @db.Date
  end_date        DateTime?      @db.Date
  status          String         @default("active")
  budget          Decimal?       @db.Decimal(15, 2)
  location        Json?          // PostGIS geometry as GeoJSON
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)

  client          clients?       @relation(fields: [client_id], references: [id], onDelete: SetNull)
  responsible     profiles?      @relation(fields: [responsible_id], references: [id], onDelete: SetNull)
  buildings       buildings[]
  requirements    requirements[]
  experiences     experiences[]
  prescriptions   prescriptions[]
  proposals       proposals[]

  @@map("projects")
}

model buildings {
  id              String        @id @default(uuid()) @db.Uuid
  project_id      String        @db.Uuid
  name            String
  description     String?
  type            building_type @default(OTHER)
  address         String?
  floors_count    Int?
  total_area      Decimal?      @db.Decimal(12, 2)
  location        Json?         // PostGIS geometry as GeoJSON
  solution_level  solution_level @default(NONE)
  detection_state detection_state @default(NOT_STARTED)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)

  project         projects      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  floors          floors[]
  systems         systems[]
  technical_zones technical_zones[]

  @@map("buildings")
}

model floors {
  id            String    @id @default(uuid()) @db.Uuid
  building_id   String    @db.Uuid
  name          String
  number        Int
  description   String?
  total_area    Decimal?  @db.Decimal(12, 2)
  floor_plan    Json?     // PostGIS geometry as GeoJSON
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  building      buildings @relation(fields: [building_id], references: [id], onDelete: Cascade)
  rooms         rooms[]

  @@map("floors")
}

model rooms {
  id              String          @id @default(uuid()) @db.Uuid
  floor_id        String          @db.Uuid
  name            String
  number          String?
  description     String?
  area            Decimal?        @db.Decimal(10, 2)
  capacity        Int?
  purpose         String?
  detection_state detection_state @default(NOT_STARTED)
  layout          Json?           // PostGIS geometry as GeoJSON
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)

  floor           floors          @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  equipment       equipment[]
  requirements    requirements[]
  prescriptions   prescriptions[]

  @@map("rooms")
}

// ============================================
// REQUIREMENTS & EXPERIENCES
// ============================================

model requirements {
  id          String               @id @default(uuid()) @db.Uuid
  project_id  String               @db.Uuid
  room_id     String?              @db.Uuid
  category    requirement_category @default(OTHER)
  title       String
  description String?
  priority    Int                  @default(3)
  actions     Json?                // Array of action objects
  source      String?
  created_by  String?              @db.Uuid
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @db.Timestamptz(6)

  project     projects             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  room        rooms?               @relation(fields: [room_id], references: [id], onDelete: SetNull)
  author      profiles?            @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("requirements")
}

model experiences {
  id          String   @id @default(uuid()) @db.Uuid
  project_id  String   @db.Uuid
  name        String
  description String?
  actions     Json?    // Array of action objects
  triggers    Json?    // Array of trigger conditions
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  project     projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author      profiles? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("experiences")
}

// ============================================
// SYSTEMS & SUBSYSTEMS
// ============================================

model systems {
  id            String          @id @default(uuid()) @db.Uuid
  building_id   String          @db.Uuid
  name          String
  category      system_category @default(OTHER)
  description   String?
  status        String          @default("active")
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)

  building      buildings       @relation(fields: [building_id], references: [id], onDelete: Cascade)
  subsystems    subsystems[]
  prescriptions prescriptions[]

  @@map("systems")
}

model subsystems {
  id          String         @id @default(uuid()) @db.Uuid
  system_id   String         @db.Uuid
  name        String
  type        subsystem_type @default(OTHER)
  description String?
  status      String         @default("active")
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @db.Timestamptz(6)

  system      systems        @relation(fields: [system_id], references: [id], onDelete: Cascade)
  equipment   equipment[]

  @@map("subsystems")
}

// ============================================
// EQUIPMENT
// ============================================

model equipment {
  id              String           @id @default(uuid()) @db.Uuid
  subsystem_id    String?          @db.Uuid
  room_id         String?          @db.Uuid
  supplier_id     String?          @db.Uuid
  library_ref_id  String?          @db.Uuid
  name            String
  description     String?
  status          equipment_status @default(ACTIVE)
  serial_number   String?
  install_date    DateTime?        @db.Date
  warranty_end    DateTime?        @db.Date
  properties      Json?            // Equipment-specific properties
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  subsystem       subsystems?      @relation(fields: [subsystem_id], references: [id], onDelete: SetNull)
  room            rooms?           @relation(fields: [room_id], references: [id], onDelete: SetNull)
  supplier        suppliers?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  library_ref     equipment_library? @relation(fields: [library_ref_id], references: [id], onDelete: SetNull)

  @@map("equipment")
}

model equipment_library {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  category        String
  manufacturer    String?
  model           String?
  description     String?
  specifications  Json?     // Technical specifications
  datasheet_url   String?
  image_url       String?
  is_public       Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  equipment_refs  equipment[]

  @@map("equipment_library")
}

// ============================================
// TECHNICAL ZONES
// ============================================

model technical_zones {
  id          String    @id @default(uuid()) @db.Uuid
  building_id String    @db.Uuid
  name        String
  description String?
  zone_type   String?   // e.g. "riser", "shaft", "plant_room"
  location    Json?     // PostGIS geometry as GeoJSON
  properties  Json?     // Zone-specific properties
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  building    buildings @relation(fields: [building_id], references: [id], onDelete: Cascade)

  @@map("technical_zones")
}

// ============================================
// PRESCRIPTIONS
// ============================================

model prescriptions {
  id          String               @id @default(uuid()) @db.Uuid
  project_id  String               @db.Uuid
  system_id   String?              @db.Uuid
  room_id     String?              @db.Uuid
  title       String
  description String?
  status      prescription_status  @default(DRAFT)
  priority    prescription_priority @default(MEDIUM)
  actions     Json?                // Array of action objects
  approved_by String?              @db.Uuid
  approved_at DateTime?            @db.Timestamptz(6)
  created_by  String?              @db.Uuid
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @db.Timestamptz(6)

  project     projects             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  system      systems?             @relation(fields: [system_id], references: [id], onDelete: SetNull)
  room        rooms?               @relation(fields: [room_id], references: [id], onDelete: SetNull)
  author      profiles?            @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("prescriptions")
}

// ============================================
// INTEGRATIONS
// ============================================

model integrations {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  type         integration_type  @default(CUSTOM)
  status       integration_status @default(PENDING)
  config       Json?             // Integration configuration
  credentials  Json?             // Encrypted credentials
  last_sync    DateTime?         @db.Timestamptz(6)
  created_at   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at   DateTime          @default(now()) @db.Timestamptz(6)

  @@map("integrations")
}

// ============================================
// AI MODULE
// ============================================

model ai_local_servers {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  endpoint     String
  model        String?
  description  String?
  is_active    Boolean  @default(true)
  config       Json?    // Server-specific configuration
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  patterns     ai_learned_patterns[]

  @@map("ai_local_servers")
}

model ai_learned_patterns {
  id              String           @id @default(uuid()) @db.Uuid
  server_id       String           @db.Uuid
  name            String
  pattern_type    String
  pattern_data    Json
  confidence      Decimal?         @db.Decimal(5, 4)
  validated       Boolean          @default(false)
  created_by      String?          @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  server          ai_local_servers @relation(fields: [server_id], references: [id], onDelete: Cascade)
  author          profiles?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("ai_learned_patterns")
}

model explanation_logs {
  id            String    @id @default(uuid()) @db.Uuid
  entity_type   String    // e.g. "prescription", "requirement"
  entity_id     String    @db.Uuid
  explanation   String    @db.Text
  model_used    String?
  tokens_used   Int?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  author        profiles? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("explanation_logs")
}

model domain_events {
  id          String   @id @default(uuid()) @db.Uuid
  event_type  String
  aggregate   String   // Entity type
  aggregate_id String  @db.Uuid
  payload     Json?
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  author      profiles? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("domain_events")
}

// ============================================
// ENGINEERING RULES
// ============================================

model engineering_rules {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  rule_type     String    // e.g. "validation", "calculation", "recommendation"
  condition     Json?     // Rule condition/predicate
  action        Json?     // Rule action
  priority      Int       @default(0)
  is_active     Boolean   @default(true)
  last_tested   DateTime? @db.Timestamptz(6)
  test_results  Json?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("engineering_rules")
}

// ============================================
// PRIVACY MATRIX
// ============================================

model privacy_matrix {
  id              String    @id @default(uuid()) @db.Uuid
  entity_type     String    // e.g. "project", "building", "room"
  entity_id       String    @db.Uuid
  data_category   String    // e.g. "personal", "technical", "financial"
  sensitivity     String    // "low", "medium", "high", "critical"
  retention_days  Int?
  encryption      Boolean   @default(false)
  access_roles    Json?     // Allowed roles
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@map("privacy_matrix")
}

// ============================================
// PROPOSALS
// ============================================

model proposals {
  id          String           @id @default(uuid()) @db.Uuid
  project_id  String           @db.Uuid
  title       String
  description String?
  status      proposal_status  @default(DRAFT)
  amount      Decimal?         @db.Decimal(15, 2)
  currency    String           @default("EUR")
  valid_until DateTime?        @db.Date
  content     Json?            // Proposal content/sections
  created_by  String?          @db.Uuid
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @default(now()) @db.Timestamptz(6)

  project     projects         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author      profiles?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("proposals")
}
